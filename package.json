{
  "name": "flaw-patrol-ci-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny sample test suite whose JUnit XML results can be uploaded into Flaw Patrol.",
  "scripts": {
    "test": "jest",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit",
    "test:browser": "playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/ci/jest-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "junit.xml",
    "suiteName": "Sample tests",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "ancestorSeparator": " \u203a ",
    "addFileAttribute": "true"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jest": "30.2.0",
    "jest-junit": "16.0.0"
  }
}
